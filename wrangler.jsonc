{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-esim",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "travelsimple-esim.com",
      "custom_domain": true
    },
    {
      "pattern": "www.travelsimple-esim.com",
      "custom_domain": true
    }
  ]
}
